# Payload CMS & Database
# Required in Vercel: use a managed MongoDB connection string (e.g. MongoDB Atlas).
# Percent-encode reserved characters in the username/password. Do not commit real credentials.
DATABASE_URI=
# Set a unique, random secret in Vercel (do not use a checked-in example value).
PAYLOAD_SECRET=

# Site Configuration
# Set to the canonical public URL with no trailing slash; Next.js reads this at build time.
NEXT_PUBLIC_SITE_URL=https://example.com
NEXT_PUBLIC_SITE_NAME="Celeste Expeditions"

# Maps Integration (Mapbox or Google Maps)
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Email Notifications (Resend & Nodemailer SMTP)
RESEND_API_KEY=
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_ADDRESS=concierge@example.com
EMAIL_FROM_NAME="Celeste Expeditions"
ADMIN_NOTIFICATION_EMAIL=bookings@example.com
