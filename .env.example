# MongoDB - Use ONE of these:
# For local development (no Atlas needed, uses in-memory shim that persists to .data/mongo-store.json):
DATABASE_URI=mongodb://127.0.0.1:27017/celeste-voyages
# For Atlas production - IMPORTANT: Remove < > brackets and URL-encode special chars in password
# Example: If password is MyP@ss/w0rd, encode as MyP%40ss%2Fw0rd
# DATABASE_URI=mongodb+srv://kishorshahi67_db_user:YOUR_ACTUAL_PASSWORD@travelbookingwebsite.do1t2tv.mongodb.net/celeste-voyages?retryWrites=true&w=majority&appName=TravelBookingWebsite

PAYLOAD_SECRET=hike-globally-payload-secret-key-32
NEXT_PUBLIC_SERVER_URL=https://hikeglobally.com
PAYLOAD_PUBLIC_SERVER_URL=https://hikeglobally.com
NEXT_PUBLIC_SITE_URL=https://hikeglobally.com

# Email
RESEND_API_KEY=re_...
EMAIL_FROM=bookings@yourdomain.com
