{
  "name": "celeste-alpine-coastal-voyages",
  "version": "1.0.0",
  "description": "High-end multipage adventure & luxury travel booking platform powered by Next.js 15 and Payload CMS 3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/start-with-db.mjs dev",
    "dev:next": "next dev --hostname 0.0.0.0 --port 3000",
    "build": "next build",
    "start": "node scripts/start-with-db.mjs start",
    "seed": "tsx scripts/seed.ts",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "typecheck": "tsc --noEmit"
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": true,
    "sharp": true
  },
  "dependencies": {
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@hookform/resolvers": "^5.0.1",
    "@payloadcms/db-mongodb": "3.60.0",
    "@payloadcms/email-nodemailer": "3.60.0",
    "@payloadcms/next": "3.60.0",
    "@payloadcms/richtext-lexical": "3.60.0",
    "@payloadcms/ui": "3.60.0",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.7",
    "framer-motion": "^12.6.3",
    "graphql": "^16.9.0",
    "lucide-react": "^0.487.0",
    "next": "15.5.26",
    "nodemailer": "^6.10.0",
    "payload": "3.60.0",
    "react": "19.1.9",
    "react-dom": "19.1.9",
    "react-hook-form": "^7.55.0",
    "resend": "^4.2.0",
    "sharp": "^0.33.5",
    "tailwind-merge": "^3.0.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "autoprefixer": "^10.4.21",
    "mingo": "^7.2.4",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
